{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Weetbeats",
  "version": "0.1.0",
  "identifier": "com.weetbeats.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Weetbeats",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#131118"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../assets/starter-pack": "starter-pack"
    },
    "category": "Music",
    "shortDescription": "A tiny, fun, free music maker.",
    "longDescription": "Point Weetbeats at a folder of samples, tick boxes, make beats.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
